# ==========================================================================
# dome-open-data environment variables
# Copy to .env (gitignored) for local runs. In GitHub Actions the same names
# come from repository secrets (R2_*) and the repository variable R2_BUCKET.
# ==========================================================================

# Cloudflare account that owns the bucket
R2_ACCOUNT_ID=

# R2 token: Object Read & Write, scoped to the one bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Private bucket holding raw/, clean/ and catalog/
R2_BUCKET=dome-open-data
