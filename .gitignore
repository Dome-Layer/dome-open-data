# Secrets
.env
.env.*
!.env.example

# Data never enters this public repo; it lives in the private R2 bucket
data/
*.parquet
*.csv
# ...except the country code crosswalk, which is configuration, not data
!crosswalk/*.csv
# ...and test fixtures: a few public-domain rows (ALFRED GDPC1, BEA), so the tests run offline
!tests/fixtures/**/*.csv
# ...and the insights fixture store: a cut of ECB and World Bank data, both reuse-allowed with
# attribution (tests/fixtures/store/README.md). Never an `ask` source.
!tests/fixtures/store/**/*.parquet
*.zip
*.xlsx
*.gz

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS / editors
.DS_Store
.vscode/
.cursor/
.claude/
